# Godot generated cache
.godot/

# Godot editor user directories accidentally created beside the project
export_templates/
feature_profiles/
script_templates/
text_editor_themes/

# Local captures and logs
autoshot.png
*.log
*.tmp

# tools/ 를 import 로 재사용하면서 생긴다 (fit_ground -> make_seamless)
__pycache__/

# OS/editor noise
.DS_Store
Thumbs.db
desktop.ini
.codex/

# 내보내기 산출물 — 100MB 를 넘어 GitHub 이 받지 않는다. 사장님은 이 exe 로
# 플레이하지만 저장소에 둘 물건은 아니다(빌드는 소스에서 다시 나온다).
Bloodlord.exe
Bloodlord.console.exe
Bloodlord.zip
Bloodlord.pck
# 웹 export 부산물. 루트로 뽑으면 아이콘 png 가 **게임 리소스로 임포트**되어
# (.import 가 생긴다) pck 에 딸려 들어간다 — 그래서 tools/deploy_web.sh 는
# build/web/ 으로만 뽑는다.
Bloodlord.html
Bloodlord.js
Bloodlord.wasm
Bloodlord.icon.png*
Bloodlord.apple-touch-icon.png*
Bloodlord.png*
Bloodlord.audio.*.js
build/
*.apk
*.aab

# 안드로이드 빌드 템플릿 — 내보내기 템플릿에서 푼 것이라 저장소에 안 담는다.
# 없으면 `--install-android-build-template` 로 다시 깐다.
android/

# **서명 키는 절대 커밋하지 않는다.** 잃으면 앱을 영영 갱신 못 하고,
# 새면 남이 우리 이름으로 앱을 낼 수 있다. 따로 백업해 둘 것.
*.keystore
*.jks

# Netlify CLI 가 만드는 링크 정보(사이트 id). 로컬 것이다.
.netlify/
