class_name SkinDefs

# 의상실 — 얼굴만 같고 옷·무기가 통째로 바뀌는 스킨 (사장님 2026-08-24,
# 레퍼런스: 타 방치형의 의상실 문법). 그림은 assets/anim/<id>_<motion>/ 에
# 산다 — Main 의 영웅 모션 경로가 skin 접두 하나로 갈리므로 표에 줄을
# 추가하고 그림만 깔면 스킨이 늘어난다.
#
# 보유 효과는 **산 것 전부 합산**이다 — 갈아입어도 효과는 남으니 치장이
# 수집이 된다(레퍼런스의 "보유효과" 문법 그대로).
#
# **여덟이 서로 달라야 한다**(2026-08-27 사장님: "스킨 중복부터 정리해줘").
# 정리 전에는 여덟이 효과 **셋**으로 뭉쳐 있었다 — 공격+10% 가 셋, 체력+10% 가
# 둘, 공5체5 가 둘. 합산이라 결국 다 사게 되지만, 무엇부터 살지에 이유가 없고
# 800 짜리가 1200 짜리와 효과가 똑같아서 비싼 쪽이 늘 손해였다.
#
# 축은 **전투 축 셋**만 쓴다: 공격 · 체력 · 치명 피해. 혈액 획득은 쓰지 않는다 —
# 2026-08-25 에 옵션에서 걷어낸 축이고(Main.gold_mult 주석) 그 몫을 전투 축으로
# 옮긴 것이 그때의 결정이다. 공격속도도 안 쓴다: SKILL_DUR 같은 고정 길이가
# 공속을 안 따라간다는 것이 이미 실측돼 있다(HANDOFF 8-1).
#
# 치명 피해 값은 **혈맥 노드(0.10~0.15)·유물(0.10) 과 같은 눈금**이고, 화면
# 표기도 그 규칙을 따른다(`0.10 -> "치명 피해 +10%"`). 공격 +10% 보다 실제
# dps 기여는 작지만 치명 확률이 높을수록 커지는 축이라, 무엇을 먼저 살지가
# 빌드에 따라 갈리는 것이 이 표의 목적이다.
const SKINS := [
	{"id": "valentino_1", "name": "기본 의상", "price": 0,
		"bonus": {}, "desc": "군주의 평상복"},
	# ── 1200: 세 축의 단일 셋 · 조합 셋. 여섯이 서로 다르다 ──────────────
	{"id": "demon_king", "name": "마왕의 위엄", "price": 1200,
		"bonus": {"attack": 0.05}, "desc": "보유 시 공격 +5%"},
	{"id": "dragon", "name": "용기사의 갑주", "price": 1200,
		"bonus": {"tough": 0.10}, "desc": "보유 시 체력 +10%"},
	{"id": "shadow", "name": "그림자 자객", "price": 1200,
		"bonus": {"critdmg": 0.10}, "desc": "보유 시 치명 피해 +10%"},
	{"id": "emperor", "name": "암흑 황제", "price": 1200,
		"bonus": {"attack": 0.05, "tough": 0.05},
		"desc": "보유 시 공격 +5% · 체력 +5%"},
	{"id": "grim", "name": "사신 대군주", "price": 1200,
		"bonus": {"attack": 0.05, "critdmg": 0.05},
		"desc": "보유 시 공격 +5% · 치명 피해 +5%"},
	{"id": "abyss", "name": "심연의 군주", "price": 1200,
		"bonus": {"tough": 0.05, "critdmg": 0.05},
		"desc": "보유 시 체력 +5% · 치명 피해 +5%"},
	# ── 800: 웃긴 스킨 둘은 값을 낮춘다 — 위엄이 아니라 웃음을 파는 물건이다.
	# 값이 2/3 이니 효과도 절반짜리 단일축이다. 예전엔 1200짜리와 **효과가 똑같아**
	# 힘만 보면 이쪽부터 사는 게 늘 옳았다(2026-08-27 정리).
	{"id": "hawaii", "name": "한여름 바캉스", "price": 800,
		"bonus": {"attack": 0.10}, "desc": "보유 시 공격 +10%"},
	{"id": "pink", "name": "핑크빛 군주", "price": 800,
		"bonus": {"tough": 0.05}, "desc": "보유 시 체력 +5%"},
]


static func of(id: String) -> Dictionary:
	for x in SKINS:
		if str(x["id"]) == id:
			return x
	return {}


# 산 스킨들의 보유 효과 합. 기본 의상은 효과가 없어서 안 세도 같다.
static func bonus(stat: String, owned: Dictionary) -> float:
	var v := 0.0
	for x in SKINS:
		if owned.has(str(x["id"])):
			v += float(x["bonus"].get(stat, 0.0))
	return v
